{
  "version": "1.0.0",
  "preset": "blueprint-dark",
  "mode": "dark",
  "locale": "en",
  "brand": {
    "name": "Blueprint",
    "tagline": "A premium Pterodactyl experience.",
    "primaryColor": "#6C5CE7"
  },
  "overrides": {
    "appearance.radius": "16px",
    "appearance.density": "comfortable",
    "appearance.glass": true,
    "appearance.blur": 16,
    "appearance.animations": true,
    "appearance.compact_tables": false,

    "sidebar.position": "left",
    "sidebar.collapsed": false,
    "sidebar.icons_only": false,
    "sidebar.show_labels": true,
    "sidebar.show_badges": true,
    "sidebar.floating": false,
    "sidebar.width": 256,

    "navbar.blur": true,
    "navbar.theme_switcher": true,
    "navbar.command_palette": true,
    "navbar.notifications": true,
    "navbar.search": true,
    "navbar.breadcrumb": true,
    "navbar.user_menu": true,

    "dashboard.default_view": "overview",
    "dashboard.refresh_interval": 30,
    "dashboard.show_greeting": true,
    "dashboard.show_quick_actions": true,
    "dashboard.show_resource_charts": true,
    "dashboard.show_recent_servers": true,
    "dashboard.show_activity": true,
    "dashboard.layout": "grid",
    "dashboard.widgets": [
      "stats.servers",
      "stats.users",
      "stats.memory",
      "stats.disk",
      "chart.cpu",
      "chart.memory",
      "chart.network",
      "feed.activity",
      "list.recent_servers"
    ],

    "animations.enabled": true,
    "animations.durations.base": 200,
    "animations.durations.fast": 120,
    "animations.durations.slow": 320,
    "animations.easing": "out-expo",
    "animations.shimmer": true,
    "animations.progress_stripes": true,
    "animations.caret_blink": true,
    "animations.gradient_shift": true,
    "animations.page_transitions": "fade",
    "animations.reduced_motion": "respect",

    "accessibility.focus_ring": true,
    "accessibility.keyboard_shortcuts": true,
    "accessibility.skip_to_content": true,
    "accessibility.color_blind_safe": false,
    "accessibility.high_contrast": false,
    "accessibility.font_scale": 100,
    "accessibility.min_target_size": 36,

    "developer.debug_overlay": false,
    "developer.show_query_log": false,
    "developer.expose_manifest": true,
    "developer.devtools_shortcut": "ctrl+shift+d",
    "developer.experimental_features": false,

    "security.csrf": true,
    "security.csp": true,
    "security.two_factor_required": false,
    "security.session_lifetime": 120,
    "security.ip_allowlist_enabled": false,
    "security.audit_logging": true,
    "security.intrusion_detection": true,

    "performance.virtualize_long_lists": true,
    "performance.defer_non_critical": true,
    "performance.cache_settings": true,
    "performance.lazy_charts": true,
    "performance.prefetch_command_palette": true,
    "performance.image_loading": "lazy",
    "performance.fps_target": 60,

    "experimental.widget_marketplace": true,
    "experimental.layout_builder": false,
    "experimental.voice_commands": false,
    "experimental.ai_assistant": false,
    "experimental.websocket_console": true,
    "experimental.timeline_view": false,
    "experimental.server_templates": true,

    "branding.logo_url": "/images/logo.svg",
    "branding.favicon_url": "/images/favicon.svg",
    "branding.og_image_url": "/images/og-image.svg",
    "branding.dashboard_wallpaper": "default",
    "branding.support_url": "https://discord.gg/pterodactyl",
    "branding.docs_url": "https://pterodactyl.io",
    "branding.github_url": "https://github.com/pterodactyl/panel",
    "branding.copyright": "© 2026 Blueprint. All rights reserved.",

    "notifications.toast_position": "bottom-right",
    "notifications.duration": 5000,
    "notifications.max_visible": 4,
    "notifications.persist_errors": true,
    "notifications.sound": false,
    "notifications.desktop": false,

    "command_palette.shortcut": "mod+k",
    "command_palette.recent_first": true,
    "command_palette.fuzzy": true,
    "command_palette.show_categories": true,
    "command_palette.quick_actions": [
      "nav.dashboard",
      "nav.servers",
      "nav.account",
      "action.create_server",
      "action.toggle_theme"
    ],

    "console.font_size": 13,
    "console.line_height": 1.5,
    "console.theme": "one-dark",
    "command_palette.colors": ["primary", "accent", "success", "warning", "danger"],
    "console.max_lines": 5000,
    "console.persist_history": true,
    "console.allow_paste": true,
    "console.fullscreen_shortcut": "mod+enter",

    "files.default_view": "list",
    "files.show_hidden": false,
    "files.editor": "monaco",
    "files.editor_theme": "vs-dark",
    "files.editor_tab_size": 4,
    "files.allow_archive": true,
    "files.max_upload_mb": 500,

    "tables.density": "comfortable",
    "tables.sticky_header": true,
    "tables.row_hover": true,
    "tables.compact_actions": true,
    "tables.persist_state": true,
    "tables.bulk_actions": true,

    "advanced.custom_css": "",
    "advanced.custom_js": "",
    "advanced.custom_html": "",
    "advanced.inject_after_body": false,
    "advanced.telemetry": true,
    "advanced.beta_features": false
  },
  "customCss": "",
  "customJs": "",
  "customHtml": "",
  "telemetry": {
    "endpoint": "/api/blueprint/telemetry",
    "interval": 300,
    "fields": ["errors", "settings.changes", "navigation.clicks"]
  },
  "featureFlags": {
    "commandPalette": true,
    "notificationCenter": true,
    "themeManager": true,
    "widgetSystem": true,
    "auditLog": true,
    "securityCenter": true,
    "monitoringDashboard": true,
    "serverTemplates": true
  },
  "shortcuts": {
    "openCommandPalette": "mod+k",
    "openNotifications": "mod+shift+n",
    "openAccount": "mod+,",
    "toggleSidebar": "mod+b",
    "toggleTheme": "mod+shift+l",
    "openAdmin": "mod+shift+a",
    "createServer": "mod+shift+s",
    "goToDashboard": "g d",
    "goToServers": "g s",
    "goToActivity": "g a"
  },
  "env": {
    "BLUEPRINT_THEME": "blueprint-dark",
    "BLUEPRINT_MODE": "dark",
    "BLUEPRINT_BRAND_NAME": "Blueprint",
    "BLUEPRINT_TAGLINE": "A premium Pterodactyl experience.",
    "BLUEPRINT_PRIMARY_COLOR": "#6C5CE7",
    "BLUEPRINT_RADIUS": "16px",
    "BLUEPRINT_ALLOW_REGISTRATION": true,
    "BLUEPRINT_FORGOT_PASSWORD": true,
    "BLUEPRINT_TWO_FACTOR": true,
    "BLUEPRINT_MAINTENANCE": false,
    "BLUEPRINT_CACHE_TTL": 300
  }
}